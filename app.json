{
  "expo": {
    "name": "Nyĩmbo na Kĩrĩkanĩro",
    "slug": "nyimbonakirikaniro",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nyimbonakirikaniro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F97316",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.frame.nyimbonakirikaniro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#122648"
      },
      "package": "app.frame.nyimbonakirikaniro",
      "permissions": ["RECORD_AUDIO"],
      "allowBackup": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Nyĩmbo na Kĩrĩkanĩro to access your microphone for recording hymn tunes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": ["arm64-v8a"],
            "resourceConfigurations": ["en"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

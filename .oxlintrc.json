{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_booksCache", "_touchedDefaultIds", "_seedVersion"] }],
    "no-await-in-loop": "off",
    "no-map-spread": "off"
  },
  "ignorePatterns": ["dist/**", ".expo/**", "android/**", "ios/**", "extracted/**", "node_modules/**", "src/uniwind-types.d.ts"]
}
